# Copie para .env e preencha UMA das duas opções abaixo.
# Sem nenhuma chave a aplicação sobe em modo demo, com catálogo local.

# Opção A — chave v3 (padrão, mais simples):
# themoviedb.org → Configurações → API → "Chave da API (v3)"
TMDB_API_KEY=sua_chave_v3_aqui

# Opção B — token de leitura v4 (Bearer):
TMDB_ACCESS_TOKEN=seu_token_de_leitura_v4_aqui

# Idioma das respostas (pt-BR, en-US, es-ES...)
TMDB_LANGUAGE=pt-BR

# Tempo de vida do cache em segundos (padrão: 600 = 10 min)
CACHE_TTL=600
